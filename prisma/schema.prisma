// Optional Prisma Schema for SQLite deployment
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Chapter {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  subtitle        String?
  order           Int      @default(0)
  status          String   @default("published") // "draft" | "published"
  narratorAudioUrl String?
  unlockCondition String?  // e.g. "has_cipher_key"
  blocksJson      String   // JSON-serialized Block[]
  footnotesJson   String   // JSON-serialized FootnoteItem[]
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

model MediaItem {
  id         String   @id @default(cuid())
  name       String
  filename   String
  url        String
  type       String   // "image" | "audio" | "video" | "pdf" | "json" | "other"
  mimeType   String
  size       Int
  category   String   @default("general")
  tagsJson   String   @default("[]")
  uploadedAt DateTime @default(now())
}

